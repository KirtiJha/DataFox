{
  "name": "datafox-ftp-client",
  "version": "1.0.0",
  "description": "DataFox - A modern, intuitive FTP client built with Electron, React, Next.js, and Tailwind CSS",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "next build && next export",
    "build:electron": "npm run build && electron-builder",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "ftp",
    "client",
    "electron",
    "react",
    "nextjs",
    "tailwind"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.1.3",
    "electron-builder": "^24.8.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.884.0",
    "@aws-sdk/lib-storage": "^3.884.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@heroicons/react": "^2.0.18",
    "aws-sdk": "^2.1692.0",
    "basic-ftp": "^5.0.4",
    "framer-motion": "^10.16.5",
    "lucide-react": "^0.294.0",
    "next": "^14.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "ssh2-sftp-client": "^10.0.3",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.yourcompany.modern-ftp-client",
    "productName": "Modern FTP Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "icon": "assets/icons/icon.png"
    }
  }
}
